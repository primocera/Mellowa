# ============================================================
# Mellowa — Environment Variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# NEXT_PUBLIC_* vars are exposed to the browser — safe to be public.
# Everything else is SERVER-ONLY and must never be imported in client code.
# ============================================================

# --- App (public) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Public: used by browser client for auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY: full DB access, bypasses RLS. Never in client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (Anthropic) — SERVER-ONLY ---
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=claude-haiku-4-5-20251001

# --- Stripe ---
# SERVER-ONLY
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public: used by checkout redirect on client
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SERVER-ONLY: price IDs for subscription plans
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# --- Trial-length experiment (MW-V10-02, SERVER-ONLY) ---
# Opt-in and off by default: with these unset every trial is the 3-day control.
# Assignment is server-side and pinned at checkout, so changing these NEVER
# alters a trial that already exists. Stop rules: docs/experiments/trial-length.md
FLAG_TRIAL_LENGTH_EXPERIMENT=
# Arm tested against control. Allowlisted in code: control | week_beta
TRIAL_EXPERIMENT_VARIANT=week_beta
# Integer 0-100 — share of NEW trials assigned to the variant. 0 = inactive.
TRIAL_EXPERIMENT_PERCENT=0
# Change only to start a genuinely new experiment (re-buckets future users).
TRIAL_EXPERIMENT_SALT=

# --- Admin dashboard (SERVER-ONLY) ---
# Bearer secret for programmatic /api/admin/stats access (fail-closed if unset).
ADMIN_STATS_SECRET=
# Comma-separated Supabase user ids allowed to view the /admin dashboard UI.
# Real per-user authorization; unset = nobody (fail-closed).
ADMIN_USER_IDS=

# --- Authenticated E2E (Playwright journeys.spec.ts) ---
# Opt-in: the authenticated suite skips itself unless E2E_SUPABASE_TEST=1.
# It logs in as a synthetic, clearly-labelled user seeded by
# `npm run seed:test-user`. RLS isolates that user's rows, so seeding it in the
# single live project is safe — no separate throwaway project required.
# Keep these values in sync with the seed script (it reads the same vars).
E2E_SUPABASE_TEST=
E2E_TEST_EMAIL=test@mellowa.local
E2E_TEST_PASSWORD=Mellowa123!
